<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users Directory | AlumniConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #94A3B8;
      --brand-primary: #4F46E5;
      --brand-primary-hover: #4338CA;
      --brand-accent: #0284C7;
      --status-success-bg: #DCFCE7;
      --status-success-fg: #166534;
      --status-warning-bg: #FEF3C7;
      --status-warning-fg: #92400E;
      --status-info-bg: #E0E7FF;
      --status-info-fg: #3730A3;
      --status-danger-bg: #FFE4E6;
      --status-danger-fg: #BE123C;
      --border-subtle: #E2E8F0;
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-canvas);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
    }
    .nav-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.02em;
    }
    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.18s ease;
    }
    .nav-links a:hover { color: var(--text-primary); background: var(--bg-subtle); }
    .nav-links a.active { background: #EEF2FF; color: var(--brand-primary); font-weight: 700; }
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 36px 24px 64px;
      width: 100%;
      flex: 1;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .badge-pill {
      display: inline-block;
      background: var(--status-info-bg);
      color: var(--status-info-fg);
      padding: 5px 14px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 10px;
    }
    h1 {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .subtitle { color: var(--text-secondary); font-size: 15px; max-width: 680px; }
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .card h2 {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
    }
    table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
    th {
      text-align: left;
      padding: 12px 16px;
      font-size: 12px;
      color: var(--text-secondary);
      background: var(--bg-canvas);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
      border-bottom: 1px solid var(--border-subtle);
    }
    td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--bg-subtle);
      vertical-align: middle;
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--bg-canvas); }
    .id-tag {
      font-family: var(--font-mono);
      background: var(--status-info-bg);
      color: var(--status-info-fg);
      padding: 3px 9px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 12.5px;
    }
    .actions-cell {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: all 0.18s ease;
    }
    .btn-primary {
      background: var(--brand-primary);
      color: white;
      padding: 10px 18px;
      font-size: 14px;
    }
    .btn-primary:hover { background: var(--brand-primary-hover); }
    .btn-secondary {
      background: var(--bg-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn-secondary:hover { background: var(--border-subtle); color: var(--text-primary); }
    .btn-edit {
      background: var(--status-warning-bg);
      color: var(--status-warning-fg);
    }
    .btn-edit:hover { background: #FDE68A; }
    .btn-delete {
      background: var(--status-danger-bg);
      color: var(--status-danger-fg);
    }
    .btn-delete:hover { background: #FECDD3; }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-top: 16px;
    }
    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--text-secondary);
    }
    input {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid #CBD5E1;
      border-radius: 10px;
      font-size: 14px;
      background: var(--bg-canvas);
      font-family: inherit;
      transition: all 0.15s ease;
    }
    input:focus {
      outline: none;
      background: var(--bg-surface);
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(4px);
      align-items: center;
      justify-content: center;
      z-index: 100;
    }
    .modal-content {
      background: var(--bg-surface);
      padding: 28px;
      border-radius: 16px;
      border: 1px solid var(--border-subtle);
      max-width: 480px;
      width: 92%;
      box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    }
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .site-footer a { color: var(--brand-primary); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark">🎓</span>
        <span>AlumniConnect</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/users" class="active">Users</a>
        <a href="/announcements">Announcements</a>
        <a href="/job-postings">Job Postings</a>
        <a href="/applications">Applications</a>
        <a href="/about">About</a>
        <a href="/api/swagger">Swagger API</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <div>
        <span class="badge-pill">👥 Identity & Directory Module</span>
        <h1>Users Management</h1>
        <p class="subtitle">
          Manage registered alumni accounts and administrative credentials connected to the MySQL connection pool.
        </p>
      </div>
      <a href="/api/users" target="_blank" class="btn btn-secondary">⚡ View JSON API (/api/users)</a>
    </div>

    <!-- CREATE: Add User Form -->
    <div class="card">
      <h2>➕ Register New User Account</h2>
      <form action="/users" method="POST">
        <div class="form-grid">
          <div>
            <label>Username *</label>
            <input type="text" name="username" placeholder="e.g. dilara_toraman" required>
          </div>
          <div>
            <label>Email Address *</label>
            <input type="email" name="email" placeholder="e.g. dilara@alumni.edu.tr" required>
          </div>
          <div>
            <label>Password *</label>
            <input type="password" name="password" placeholder="••••••••" required>
          </div>
          <div>
            <label>Phone Number</label>
            <input type="text" name="phone" placeholder="e.g. +90 555 0199">
          </div>
        </div>
        <div style="margin-top: 18px;">
          <button type="submit" class="btn btn-primary">Create User Account</button>
        </div>
      </form>
    </div>

    <!-- READ: Users Table -->
    <div class="card">
      <div class="card-header">
        <h2>Registered Users Directory (<%= users.length %>)</h2>
      </div>
      <% if (users.length === 0) { %>
        <p style="color: var(--text-muted);">No users found. Register one using the form above.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Email Address</th>
                <th>Phone</th>
                <th>User's Jobs (Nested API)</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
                <tr>
                  <td><span class="id-tag">#<%= u.id %></span></td>
                  <td><strong><%= u.username %></strong></td>
                  <td style="color: var(--text-secondary);"><%= u.email %></td>
                  <td style="font-family: var(--font-mono); font-size: 13px; color: var(--text-secondary);"><%= u.phone || '—' %></td>
                  <td>
                    <a href="/api/users/<%= u.id %>/jobs" target="_blank" class="btn btn-secondary" style="padding: 5px 10px; font-size: 12px; font-family: var(--font-mono);">
                      /api/users/<%= u.id %>/jobs ↗
                    </a>
                  </td>
                  <td>
                    <div class="actions-cell">
                      <button class="btn btn-edit" onclick="openEditModal(<%= u.id %>, '<%= u.username %>', '<%= u.email %>', '<%= u.phone || '' %>')">✏️ Edit</button>
                      <form action="/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Delete this user?');">
                        <button type="submit" class="btn btn-delete">🗑️ Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <!-- UPDATE Modal -->
  <div id="editModal" class="modal">
    <div class="modal-content">
      <h2 style="font-family: var(--font-display); font-size: 20px; margin-bottom: 16px;">Edit User Account</h2>
      <form id="editForm" method="POST">
        <div style="margin-bottom: 14px;">
          <label>Username</label>
          <input type="text" id="editUsername" name="username" required>
        </div>
        <div style="margin-bottom: 14px;">
          <label>Email Address</label>
          <input type="email" id="editEmail" name="email" required>
        </div>
        <div style="margin-bottom: 14px;">
          <label>Phone Number</label>
          <input type="text" id="editPhone" name="phone">
        </div>
        <div style="display: flex; gap: 10px; margin-top: 20px;">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <footer class="site-footer">
    AlumniConnect — University Alumni & Career Network ·
    <a href="/">Home</a> · <a href="/job-postings">Job Postings</a> · <a href="/api/swagger">Swagger Docs</a>
  </footer>

  <script>
    function openEditModal(id, username, email, phone) {
      document.getElementById('editForm').action = '/users/' + id + '/update';
      document.getElementById('editUsername').value = username;
      document.getElementById('editEmail').value = email;
      document.getElementById('editPhone').value = phone;
      document.getElementById('editModal').style.display = 'flex';
    }
    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
    }
  </script>
</body>
</html>
