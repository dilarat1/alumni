<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Alumni System</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f4f6f9;
      color: #1a1a2e;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .card-404 {
      background: white;
      max-width: 600px;
      width: 100%;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      padding: 40px 32px;
      text-align: center;
      border-top: 6px solid #e11d48;
    }
    .badge-404 {
      display: inline-block;
      background: #ffe4e6;
      color: #be123c;
      font-weight: 700;
      font-size: 13px;
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 16px;
    }
    .code {
      font-size: 72px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1;
      margin-bottom: 12px;
    }
    h1 {
      font-size: 24px;
      color: #1e293b;
      margin-bottom: 12px;
    }
    .reason-box {
      background: #fff1f2;
      border: 1px solid #fecdd3;
      color: #9f1239;
      padding: 14px 18px;
      border-radius: 8px;
      font-size: 14px;
      margin: 18px 0 24px;
      text-align: left;
      word-break: break-word;
    }
    .nav-links {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      transition: all 0.2s;
    }
    .btn-primary {
      background: #0284c7;
      color: white;
    }
    .btn-primary:hover { background: #0369a1; }
    .btn-secondary {
      background: #f1f5f9;
      color: #334155;
    }
    .btn-secondary:hover { background: #e2e8f0; }
  </style>
</head>
<body>
  <div class="card-404">
    <span class="badge-404">🛡️ 404 Guardian Middleware</span>
    <div class="code">404</div>
    <h1>Page or Resource Not Found</h1>
    <p style="color: #64748b; font-size: 15px;">
      We couldn't find the page you were looking for. You were redirected here because the requested route is invalid or does not exist.
    </p>

    <div class="reason-box">
      <% if (from) { %>
        <div style="margin-bottom: 6px;"><strong>Requested Path:</strong> <code><%= from %></code></div>
      <% } %>
      <div><strong>Reason:</strong> <%= reason %></div>
    </div>

    <div class="nav-links">
      <a href="/" class="btn btn-primary">← Back to Home</a>
      <a href="/job-postings" class="btn btn-secondary">Job Postings</a>
      <a href="/users" class="btn btn-secondary">Users</a>
      <a href="/announcements" class="btn btn-secondary">Announcements</a>
      <a href="/applications" class="btn btn-secondary">Applications</a>
    </div>
  </div>
</body>
</html>
