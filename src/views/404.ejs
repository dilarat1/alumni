<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | AlumniConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #94A3B8;
      --brand-primary: #4F46E5;
      --brand-primary-hover: #4338CA;
      --brand-accent: #0284C7;
      --status-danger-bg: #FFE4E6;
      --status-danger-fg: #BE123C;
      --border-subtle: #E2E8F0;
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-canvas);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
    }
    .nav-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.02em;
    }
    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.18s ease;
    }
    .nav-links a:hover { color: var(--text-primary); background: var(--bg-subtle); }
    .main-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
    }
    .card-404 {
      background: var(--bg-surface);
      max-width: 620px;
      width: 100%;
      border-radius: 16px;
      border: 1px solid var(--border-subtle);
      border-top: 6px solid #E11D48;
      box-shadow: 0 12px 32px -8px rgba(15, 23, 42, 0.08);
      padding: 40px 32px;
      text-align: center;
    }
    .badge-404 {
      display: inline-block;
      background: var(--status-danger-bg);
      color: var(--status-danger-fg);
      font-weight: 700;
      font-size: 12.5px;
      padding: 5px 14px;
      border-radius: 9999px;
      margin-bottom: 14px;
    }
    .code {
      font-family: var(--font-display);
      font-size: 72px;
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1;
      margin-bottom: 10px;
      letter-spacing: -0.03em;
    }
    h1 {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 10px;
    }
    .reason-box {
      background: #FFF1F2;
      border: 1px solid #FECDD3;
      color: #9F1239;
      padding: 14px 18px;
      border-radius: 10px;
      font-size: 14px;
      margin: 20px 0 26px;
      text-align: left;
      word-break: break-word;
    }
    code {
      font-family: var(--font-mono);
      background: rgba(255,255,255,0.7);
      padding: 2px 6px;
      border-radius: 4px;
    }
    .nav-btns {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      transition: all 0.18s ease;
    }
    .btn-primary { background: var(--brand-primary); color: white; }
    .btn-primary:hover { background: var(--brand-primary-hover); }
    .btn-secondary { background: var(--bg-subtle); color: var(--text-secondary); border: 1px solid var(--border-subtle); }
    .btn-secondary:hover { background: var(--border-subtle); color: var(--text-primary); }
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 20px;
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .site-footer a { color: var(--brand-primary); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark">🎓</span>
        <span>AlumniConnect</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/users">Users</a>
        <a href="/announcements">Announcements</a>
        <a href="/job-postings">Job Postings</a>
        <a href="/applications">Applications</a>
        <a href="/about">About</a>
        <a href="/api/swagger">Swagger API</a>
      </div>
    </div>
  </nav>

  <main class="main-wrap">
    <div class="card-404">
      <span class="badge-404">🛡️ 404 Guardian Middleware</span>
      <div class="code">404</div>
      <h1>Page or Resource Not Found</h1>
      <p style="color: var(--text-secondary); font-size: 15px;">
        We couldn't find the page you were looking for. You were redirected here because the requested route is invalid or does not exist.
      </p>

      <div class="reason-box">
        <% if (from) { %>
          <div style="margin-bottom: 6px;"><strong>Requested Path:</strong> <code><%= from %></code></div>
        <% } %>
        <div><strong>Reason:</strong> <%= reason %></div>
      </div>

      <div class="nav-btns">
        <a href="/" class="btn btn-primary">← Back to Home</a>
        <a href="/job-postings" class="btn btn-secondary">Job Postings</a>
        <a href="/users" class="btn btn-secondary">Users</a>
        <a href="/announcements" class="btn btn-secondary">Announcements</a>
        <a href="/applications" class="btn btn-secondary">Applications</a>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    AlumniConnect — University Alumni & Career Network · <a href="/">Home</a> · <a href="/about">About</a>
  </footer>
</body>
</html>
