<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Applications Dashboard | AlumniConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #94A3B8;
      --brand-primary: #4F46E5;
      --brand-primary-hover: #4338CA;
      --brand-accent: #0284C7;
      --status-success-bg: #DCFCE7;
      --status-success-fg: #166534;
      --status-warning-bg: #FEF3C7;
      --status-warning-fg: #92400E;
      --status-info-bg: #E0E7FF;
      --status-info-fg: #3730A3;
      --status-danger-bg: #FFE4E6;
      --status-danger-fg: #BE123C;
      --border-subtle: #E2E8F0;
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-canvas);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
    }
    .nav-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.02em;
    }
    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.18s ease;
    }
    .nav-links a:hover { color: var(--text-primary); background: var(--bg-subtle); }
    .nav-links a.active { background: #EEF2FF; color: var(--brand-primary); font-weight: 700; }
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 36px 24px 64px;
      width: 100%;
      flex: 1;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .badge-pill {
      display: inline-block;
      background: var(--status-success-bg);
      color: var(--status-success-fg);
      padding: 5px 14px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 10px;
    }
    h1 {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .subtitle { color: var(--text-secondary); font-size: 15px; max-width: 680px; }
    .alert-success {
      background: var(--status-success-bg);
      color: var(--status-success-fg);
      border: 1px solid #BBF7D0;
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 22px;
      font-weight: 600;
      font-size: 14px;
    }
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .card h2 {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      margin-bottom: 18px;
    }
    .table-container {
      overflow-x: auto;
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
    }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { padding: 13px 16px; text-align: left; border-bottom: 1px solid var(--bg-subtle); vertical-align: middle; }
    th {
      background: var(--bg-canvas);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border-subtle);
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--bg-canvas); }
    .id-tag {
      font-family: var(--font-mono);
      background: var(--bg-subtle);
      color: var(--text-secondary);
      padding: 3px 8px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 12px;
    }
    .status-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
    }
    .status-Pending { background: var(--status-warning-bg); color: var(--status-warning-fg); }
    .status-Reviewing { background: var(--status-info-bg); color: var(--status-info-fg); }
    .status-Accepted { background: var(--status-success-bg); color: var(--status-success-fg); }
    .status-Rejected { background: var(--status-danger-bg); color: var(--status-danger-fg); }
    .action-forms { display: flex; gap: 6px; align-items: center; }
    select.status-select {
      font-size: 12.5px;
      padding: 6px 8px;
      border: 1px solid #CBD5E1;
      border-radius: 8px;
      background: var(--bg-canvas);
      font-family: inherit;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .btn-secondary {
      background: var(--bg-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn-secondary:hover { background: var(--border-subtle); color: var(--text-primary); }
    button.btn-small {
      padding: 6px 10px;
      font-size: 12px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      transition: all 0.15s ease;
    }
    .btn-update { background: var(--brand-primary); color: white; }
    .btn-update:hover { background: var(--brand-primary-hover); }
    .btn-del { background: var(--status-danger-bg); color: var(--status-danger-fg); }
    .btn-del:hover { background: #FECDD3; }
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .site-footer a { color: var(--brand-primary); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark">🎓</span>
        <span>AlumniConnect</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/users">Users</a>
        <a href="/announcements">Announcements</a>
        <a href="/job-postings">Job Postings</a>
        <a href="/applications" class="active">Applications</a>
        <a href="/about">About</a>
        <a href="/api/swagger">Swagger API</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <div>
        <span class="badge-pill">📋 Candidate Review Pipeline</span>
        <h1>Candidate Applications Dashboard</h1>
        <p class="subtitle">
          Monitor candidate applications across all job postings and transition review statuses in real time.
        </p>
      </div>
      <a href="/api/applications" target="_blank" class="btn btn-secondary">⚡ View JSON API (/api/applications)</a>
    </div>

    <% if (success) { %>
      <div class="alert-success">✓ <%= success %></div>
    <% } %>

    <div class="card">
      <h2>All Candidate Submissions (<%= applications.length %>)</h2>

      <% if (applications.length === 0) { %>
        <p style="color: var(--text-muted); margin-top: 10px;">No applications submitted yet.</p>
      <% } else { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Applicant</th>
                <th>Target Job Opportunity</th>
                <th>Portfolio / Resume</th>
                <th>Cover Note</th>
                <th>Status</th>
                <th>Change Status</th>
                <th>Delete</th>
              </tr>
            </thead>
            <tbody>
              <% applications.forEach(app => { %>
                <tr>
                  <td><span class="id-tag">#<%= app.id %></span></td>
                  <td>
                    <strong><%= app.applicant_name %></strong><br>
                    <span style="font-size: 12.5px; color: var(--text-secondary);"><%= app.applicant_email %></span>
                  </td>
                  <td>
                    <a href="/job-postings/<%= app.job_posting_id %>" style="color: var(--brand-primary); text-decoration: none; font-weight: 600;">
                      <%= app.job_title %>
                    </a><br>
                    <span style="font-size: 12px; color: var(--text-secondary);">🏢 <%= app.job_company %> (<%= app.job_location || 'Flexible' %>)</span>
                  </td>
                  <td>
                    <% if (app.resume_url) { %>
                      <a href="<%= app.resume_url %>" target="_blank" style="color: var(--brand-accent); font-weight: 600; text-decoration: none;">View CV ↗</a>
                    <% } else { %>
                      <span style="color: var(--text-muted);">—</span>
                    <% } %>
                  </td>
                  <td style="max-width: 220px; font-size: 12.5px; color: var(--text-secondary);">
                    <%= app.cover_letter ? (app.cover_letter.length > 70 ? app.cover_letter.substring(0, 70) + '...' : app.cover_letter) : '—' %>
                  </td>
                  <td>
                    <span class="status-badge status-<%= app.status %>"><%= app.status %></span>
                  </td>
                  <td>
                    <form action="/applications/<%= app.id %>/status" method="POST" class="action-forms">
                      <select name="status" class="status-select">
                        <option value="Pending" <%= app.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Reviewing" <%= app.status === 'Reviewing' ? 'selected' : '' %>>Reviewing</option>
                        <option value="Accepted" <%= app.status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                        <option value="Rejected" <%= app.status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                      </select>
                      <button type="submit" class="btn-small btn-update">Save</button>
                    </form>
                  </td>
                  <td>
                    <form action="/applications/<%= app.id %>/delete" method="POST" onsubmit="return confirm('Delete this application?');">
                      <button type="submit" class="btn-small btn-del">✕</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="site-footer">
    AlumniConnect — University Alumni & Career Network ·
    <a href="/">Home</a> · <a href="/job-postings">Job Postings</a> · <a href="/api/swagger">Swagger Docs</a>
  </footer>
</body>
</html>
