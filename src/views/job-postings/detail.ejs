<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= job.title %> | AlumniConnect Career Center</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #94A3B8;
      --brand-primary: #4F46E5;
      --brand-primary-hover: #4338CA;
      --brand-accent: #0284C7;
      --status-success-bg: #DCFCE7;
      --status-success-fg: #166534;
      --status-warning-bg: #FEF3C7;
      --status-warning-fg: #92400E;
      --status-info-bg: #E0E7FF;
      --status-info-fg: #3730A3;
      --status-danger-bg: #FFE4E6;
      --status-danger-fg: #BE123C;
      --border-subtle: #E2E8F0;
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-canvas);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
    }
    .nav-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.02em;
    }
    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.18s ease;
    }
    .nav-links a:hover { color: var(--text-primary); background: var(--bg-subtle); }
    .nav-links a.active { background: #EEF2FF; color: var(--brand-primary); font-weight: 700; }
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 36px 24px 64px;
      width: 100%;
      flex: 1;
    }
    .breadcrumb-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .alert-success {
      background: var(--status-success-bg);
      color: var(--status-success-fg);
      border: 1px solid #BBF7D0;
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 22px;
      font-weight: 600;
      font-size: 14px;
    }
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .card h2 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .badge-type {
      background: var(--status-info-bg);
      color: var(--status-info-fg);
      padding: 5px 14px;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 12.5px;
    }
    .job-title {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    .meta-bar {
      display: flex;
      gap: 18px;
      color: var(--text-secondary);
      font-size: 14px;
      margin: 12px 0 22px;
      flex-wrap: wrap;
    }
    .section-title {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 700;
      color: var(--text-primary);
      margin: 20px 0 8px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .desc-text { color: var(--text-secondary); line-height: 1.7; font-size: 15px; }
    .req-box {
      background: var(--bg-canvas);
      border-left: 4px solid var(--brand-accent);
      padding: 16px 20px;
      border-radius: 0 10px 10px 0;
      font-size: 14.5px;
      color: var(--text-secondary);
      line-height: 1.65;
    }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 18px;
    }
    @media (max-width: 768px) {
      .form-grid { grid-template-columns: 1fr; }
    }
    .form-group { display: flex; flex-direction: column; }
    .form-group.full { grid-column: 1 / -1; }
    label { font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text-secondary); }
    input, textarea {
      padding: 11px 14px;
      border: 1px solid #CBD5E1;
      border-radius: 10px;
      font-size: 14px;
      font-family: inherit;
      background: var(--bg-canvas);
      transition: all 0.15s ease;
    }
    input:focus, textarea:focus {
      outline: none;
      background: var(--bg-surface);
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      border-radius: 10px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .btn-primary { background: var(--brand-primary); color: white; }
    .btn-primary:hover { background: var(--brand-primary-hover); }
    .btn-secondary {
      background: var(--bg-surface);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn-secondary:hover { background: var(--bg-subtle); color: var(--text-primary); }
    .table-container {
      overflow-x: auto;
      margin-top: 14px;
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
    }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { padding: 13px 16px; text-align: left; border-bottom: 1px solid var(--bg-subtle); }
    th {
      background: var(--bg-canvas);
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border-subtle);
    }
    tr:last-child td { border-bottom: none; }
    .status-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
    }
    .status-Pending { background: var(--status-warning-bg); color: var(--status-warning-fg); }
    .status-Reviewing { background: var(--status-info-bg); color: var(--status-info-fg); }
    .status-Accepted { background: var(--status-success-bg); color: var(--status-success-fg); }
    .status-Rejected { background: var(--status-danger-bg); color: var(--status-danger-fg); }
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .site-footer a { color: var(--brand-primary); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark">🎓</span>
        <span>AlumniConnect</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/users">Users</a>
        <a href="/announcements">Announcements</a>
        <a href="/job-postings" class="active">Job Postings</a>
        <a href="/applications">Applications</a>
        <a href="/about">About</a>
        <a href="/api/swagger">Swagger API</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="breadcrumb-bar">
      <a href="/job-postings" class="btn btn-secondary">← Back to All Job Postings</a>
      <a href="/api/job-postings/<%= job.id %>/applications" target="_blank" class="btn btn-secondary">⚡ View Nested JSON API</a>
    </div>

    <% if (success) { %>
      <div class="alert-success">✓ <%= success %></div>
    <% } %>

    <!-- Job Header Card -->
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap;">
        <h1 class="job-title"><%= job.title %></h1>
        <span class="badge-type"><%= job.type || 'Full-time' %></span>
      </div>

      <div class="meta-bar">
        <span>🏢 <strong style="color: var(--text-primary);"><%= job.company %></strong></span>
        <span>📍 <%= job.city || job.location || 'Flexible / Unspecified' %></span>
        <% if (job.salary) { %>
          <span>💰 <%= job.salary %></span>
        <% } %>
        <% if (job.contact_email) { %>
          <span>✉️ <%= job.contact_email %></span>
        <% } %>
        <span>📅 <%= new Date(job.created_at).toLocaleDateString() %></span>
      </div>

      <div class="section-title">Role Overview & Description</div>
      <p class="desc-text"><%= job.description || 'No additional description provided for this role.' %></p>

      <% if (job.requirements) { %>
        <div class="section-title">Requirements & Qualifications</div>
        <div class="req-box"><%= job.requirements %></div>
      <% } %>
    </div>

    <!-- Candidate Application Form -->
    <div class="card">
      <h2>📝 Submit Application for this Position</h2>
      <p style="color: var(--text-secondary); font-size: 14.5px; margin-bottom: 18px;">
        Your application will be directly associated with <strong><%= job.title %></strong> at <strong><%= job.company %></strong>.
      </p>

      <form action="/job-postings/<%= job.id %>/apply" method="POST">
        <div class="form-grid">
          <div class="form-group">
            <label>Full Name *</label>
            <input type="text" name="applicant_name" placeholder="e.g. Dilara Toraman" required>
          </div>
          <div class="form-group">
            <label>Email Address *</label>
            <input type="email" name="applicant_email" placeholder="e.g. dilara@alumni.edu.tr" required>
          </div>
          <div class="form-group full">
            <label>Portfolio / Resume Link (Optional)</label>
            <input type="url" name="resume_url" placeholder="https://linkedin.com/in/... or https://github.com/...">
          </div>
          <div class="form-group full">
            <label>Cover Letter / Motivation (Optional)</label>
            <textarea name="cover_letter" rows="3" placeholder="Explain why you are an ideal fit for this role..."></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Submit Application</button>
      </form>
    </div>

    <!-- Received Applications for this Job -->
    <div class="card">
      <h2>📬 Candidate Applications for this Job (<%= job.applications ? job.applications.length : 0 %>)</h2>
      
      <% if (!job.applications || job.applications.length === 0) { %>
        <p style="color: var(--text-muted); margin-top: 10px;">No applications received yet for this position.</p>
      <% } else { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Applicant</th>
                <th>Email</th>
                <th>Portfolio / Resume</th>
                <th>Cover Note</th>
                <th>Status</th>
                <th>Submitted</th>
              </tr>
            </thead>
            <tbody>
              <% job.applications.forEach(app => { %>
                <tr>
                  <td><strong><%= app.applicant_name %></strong></td>
                  <td style="color: var(--text-secondary);"><%= app.applicant_email %></td>
                  <td>
                    <% if (app.resume_url) { %>
                      <a href="<%= app.resume_url %>" target="_blank" style="color: var(--brand-primary); font-weight: 600; text-decoration: none;">Portfolio ↗</a>
                    <% } else { %>
                      <span style="color: var(--text-muted);">—</span>
                    <% } %>
                  </td>
                  <td style="max-width: 260px; font-size: 13px; color: var(--text-secondary);">
                    <%= app.cover_letter ? (app.cover_letter.length > 80 ? app.cover_letter.substring(0, 80) + '...' : app.cover_letter) : '—' %>
                  </td>
                  <td>
                    <span class="status-badge status-<%= app.status %>"><%= app.status %></span>
                  </td>
                  <td style="font-size: 12.5px; color: var(--text-muted); font-family: var(--font-mono);"><%= new Date(app.created_at).toLocaleDateString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="site-footer">
    AlumniConnect — University Alumni & Career Network ·
    <a href="/job-postings">← All Job Postings</a> · <a href="/applications">Applications Dashboard</a>
  </footer>
</body>
</html>
