<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Postings & Career Opportunities | AlumniConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #94A3B8;
      --brand-primary: #4F46E5;
      --brand-primary-hover: #4338CA;
      --brand-accent: #0284C7;
      --status-success-bg: #DCFCE7;
      --status-success-fg: #166534;
      --status-warning-bg: #FEF3C7;
      --status-warning-fg: #92400E;
      --status-info-bg: #E0E7FF;
      --status-info-fg: #3730A3;
      --status-danger-bg: #FFE4E6;
      --status-danger-fg: #BE123C;
      --border-subtle: #E2E8F0;
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-canvas);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
    }
    .nav-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.02em;
    }
    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.18s ease;
    }
    .nav-links a:hover { color: var(--text-primary); background: var(--bg-subtle); }
    .nav-links a.active { background: #EEF2FF; color: var(--brand-primary); font-weight: 700; }
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 36px 24px 64px;
      width: 100%;
      flex: 1;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .badge-pill {
      display: inline-block;
      background: #E0F2FE;
      color: var(--brand-accent);
      padding: 5px 14px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 10px;
    }
    h1 {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .subtitle { color: var(--text-secondary); font-size: 15px; max-width: 680px; }
    .alert-success {
      background: var(--status-success-bg);
      color: var(--status-success-fg);
      border: 1px solid #BBF7D0;
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 22px;
      font-weight: 600;
      font-size: 14px;
    }
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .card h2 {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      margin-bottom: 18px;
      letter-spacing: -0.01em;
    }
    .job-card {
      border: 1px solid var(--border-subtle);
      border-left: 4px solid var(--brand-accent);
      padding: 22px 24px;
      margin-bottom: 16px;
      background: var(--bg-canvas);
      border-radius: 12px;
      transition: all 0.18s ease;
    }
    .job-card:hover {
      background: var(--bg-surface);
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -6px rgba(15, 23, 42, 0.08);
    }
    .job-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 8px;
      flex-wrap: wrap;
      gap: 8px;
    }
    .job-title {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      color: var(--text-primary);
    }
    .badge-type {
      background: var(--status-info-bg);
      color: var(--status-info-fg);
      padding: 4px 12px;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 12px;
    }
    .job-meta {
      display: flex;
      gap: 16px;
      font-size: 13.5px;
      color: var(--text-secondary);
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .job-desc {
      color: var(--text-secondary);
      font-size: 14.5px;
      line-height: 1.65;
      margin-bottom: 14px;
    }
    .job-req {
      background: var(--bg-subtle);
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      color: var(--text-primary);
      margin-bottom: 16px;
    }
    .job-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 14px;
      border-top: 1px dashed var(--border-subtle);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 16px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .btn-primary {
      background: var(--brand-primary);
      color: white;
    }
    .btn-primary:hover { background: var(--brand-primary-hover); }
    .btn-secondary {
      background: var(--bg-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn-secondary:hover { background: var(--border-subtle); color: var(--text-primary); }
    .btn-danger {
      background: var(--status-danger-bg);
      color: var(--status-danger-fg);
    }
    .btn-danger:hover { background: #FECDD3; }
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 18px;
    }
    @media (max-width: 768px) {
      .form-grid { grid-template-columns: 1fr; }
    }
    .form-group { display: flex; flex-direction: column; }
    .form-group.full { grid-column: 1 / -1; }
    label {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--text-secondary);
    }
    input, select, textarea {
      padding: 11px 14px;
      border: 1px solid #CBD5E1;
      border-radius: 10px;
      font-size: 14px;
      font-family: inherit;
      background: var(--bg-canvas);
      transition: all 0.15s ease;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      background: var(--bg-surface);
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .site-footer a { color: var(--brand-primary); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark">🎓</span>
        <span>AlumniConnect</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/users">Users</a>
        <a href="/announcements">Announcements</a>
        <a href="/job-postings" class="active">Job Postings</a>
        <a href="/applications">Applications</a>
        <a href="/about">About</a>
        <a href="/api/swagger">Swagger API</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <div>
        <span class="badge-pill">💼 Career & Alumni Employment</span>
        <h1>Job Postings & Opportunities</h1>
        <p class="subtitle">
          Browse verified roles shared by hiring partners and alumni startups, or publish an open position.
        </p>
      </div>
      <a href="/api/job-postings" target="_blank" class="btn btn-secondary">⚡ View JSON API (/api/job-postings)</a>
    </div>

    <% if (success) { %>
      <div class="alert-success">✓ <%= success %></div>
    <% } %>

    <!-- Create Job Posting Form -->
    <div class="card">
      <h2>📢 Post a New Job Opportunity</h2>
      <form action="/job-postings" method="POST">
        <div class="form-grid">
          <div class="form-group">
            <label>Job Title * (max 120 characters)</label>
            <input type="text" name="title" maxlength="120" placeholder="e.g. Senior Backend Engineer" required>
          </div>
          <div class="form-group">
            <label>Company / Organization *</label>
            <input type="text" name="company" placeholder="e.g. Trendyol Group" required>
          </div>
          <div class="form-group">
            <label>City / Location (Optional)</label>
            <input type="text" name="location" placeholder="e.g. Istanbul (Hybrid) or Remote">
          </div>
          <div class="form-group">
            <label>Employment Type</label>
            <select name="type">
              <option value="Full-time">Full-time</option>
              <option value="Part-time">Part-time</option>
              <option value="Internship">Internship</option>
              <option value="Hybrid">Hybrid</option>
              <option value="Remote">Remote</option>
            </select>
          </div>
          <div class="form-group">
            <label>Salary / Compensation Range (Optional)</label>
            <input type="text" name="salary" placeholder="e.g. ₺95,000 - ₺120,000 / month">
          </div>
          <div class="form-group">
            <label>Contact / Recruiter Email (Optional)</label>
            <input type="email" name="contact_email" placeholder="e.g. careers@company.com">
          </div>
          <div class="form-group full">
            <label>Job Description (Optional)</label>
            <textarea name="description" rows="3" placeholder="Overview of the position, team, and day-to-day responsibilities..."></textarea>
          </div>
          <div class="form-group full">
            <label>Key Requirements & Qualifications (Optional)</label>
            <textarea name="requirements" rows="2" placeholder="e.g. 2+ years Node.js, Express, Docker experience..."></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Publish Job Posting</button>
      </form>
    </div>

    <!-- Active Listings -->
    <div class="card">
      <h2>Active Job Openings (<%= postings.length %>)</h2>

      <% if (postings.length === 0) { %>
        <p style="color: var(--text-muted);">No job postings available yet. Publish one above!</p>
      <% } else { %>
        <% postings.forEach(job => { %>
          <div class="job-card">
            <div class="job-header">
              <div class="job-title"><%= job.title %></div>
              <span class="badge-type"><%= job.type || 'Full-time' %></span>
            </div>
            <div class="job-meta">
              <span>🏢 <strong><%= job.company %></strong></span>
              <span>📍 <%= job.city || job.location || 'Flexible / Unspecified' %></span>
              <% if (job.salary) { %>
                <span>💰 <%= job.salary %></span>
              <% } %>
              <span>📅 <%= new Date(job.created_at).toLocaleDateString() %></span>
            </div>
            <% if (job.description) { %>
              <p class="job-desc"><%= job.description %></p>
            <% } %>
            <% if (job.requirements) { %>
              <div class="job-req"><strong>Requirements:</strong> <%= job.requirements %></div>
            <% } %>
            <div class="job-actions">
              <a href="/job-postings/<%= job.id %>" class="btn btn-primary">View Details & Apply →</a>
              <form action="/job-postings/<%= job.id %>/delete" method="POST" onsubmit="return confirm('Delete this job posting?');">
                <button type="submit" class="btn btn-danger">🗑️ Delete</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>

  <footer class="site-footer">
    AlumniConnect — University Alumni & Career Network ·
    <a href="/">Home</a> · <a href="/applications">Applications</a> · <a href="/api/swagger">Swagger Docs</a>
  </footer>
</body>
</html>
