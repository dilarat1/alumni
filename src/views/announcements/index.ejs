<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Campus Announcements | AlumniConnect</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-canvas: #F8FAFC;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F1F5F9;
      --text-primary: #0F172A;
      --text-secondary: #475569;
      --text-muted: #94A3B8;
      --brand-primary: #4F46E5;
      --brand-primary-hover: #4338CA;
      --brand-accent: #0284C7;
      --status-success-bg: #DCFCE7;
      --status-success-fg: #166534;
      --status-warning-bg: #FEF3C7;
      --status-warning-fg: #92400E;
      --status-info-bg: #E0E7FF;
      --status-info-fg: #3730A3;
      --status-danger-bg: #FFE4E6;
      --status-danger-fg: #BE123C;
      --border-subtle: #E2E8F0;
      --font-display: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-canvas);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
    }
    .nav-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 14px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -0.02em;
    }
    .brand-mark {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-accent));
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.18s ease;
    }
    .nav-links a:hover { color: var(--text-primary); background: var(--bg-subtle); }
    .nav-links a.active { background: #EEF2FF; color: var(--brand-primary); font-weight: 700; }
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 36px 24px 64px;
      width: 100%;
      flex: 1;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .badge-pill {
      display: inline-block;
      background: var(--status-warning-bg);
      color: var(--status-warning-fg);
      padding: 5px 14px;
      border-radius: 9999px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 10px;
    }
    h1 {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .subtitle { color: var(--text-secondary); font-size: 15px; max-width: 680px; }
    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 28px;
      margin-bottom: 24px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .card h2 {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      margin-bottom: 18px;
      letter-spacing: -0.01em;
    }
    .announcement-item {
      border: 1px solid var(--border-subtle);
      border-left: 4px solid var(--brand-primary);
      padding: 20px 22px;
      margin-bottom: 16px;
      background: var(--bg-canvas);
      border-radius: 12px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      transition: all 0.18s ease;
    }
    .announcement-item:hover {
      background: var(--bg-surface);
      box-shadow: 0 8px 20px -6px rgba(15, 23, 42, 0.08);
    }
    .announcement-title {
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .cat-tag {
      background: var(--status-info-bg);
      color: var(--status-info-fg);
      font-size: 11.5px;
      padding: 3px 10px;
      border-radius: 9999px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .announcement-content {
      font-size: 14.5px;
      color: var(--text-secondary);
      line-height: 1.65;
      margin-bottom: 12px;
    }
    .announcement-meta {
      font-size: 12.5px;
      color: var(--text-muted);
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .actions {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      text-decoration: none;
      transition: all 0.18s ease;
    }
    .btn-primary {
      background: var(--brand-primary);
      color: white;
      padding: 10px 18px;
      font-size: 14px;
    }
    .btn-primary:hover { background: var(--brand-primary-hover); }
    .btn-secondary {
      background: var(--bg-subtle);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
    }
    .btn-secondary:hover { background: var(--border-subtle); color: var(--text-primary); }
    .btn-edit { background: var(--status-warning-bg); color: var(--status-warning-fg); }
    .btn-edit:hover { background: #FDE68A; }
    .btn-delete { background: var(--status-danger-bg); color: var(--status-danger-fg); }
    .btn-delete:hover { background: #FECDD3; }
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }
    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--text-secondary);
    }
    input, select, textarea {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid #CBD5E1;
      border-radius: 10px;
      font-size: 14px;
      background: var(--bg-canvas);
      font-family: inherit;
      transition: all 0.15s ease;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      background: var(--bg-surface);
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.55);
      backdrop-filter: blur(4px);
      align-items: center;
      justify-content: center;
      z-index: 100;
    }
    .modal-content {
      background: var(--bg-surface);
      padding: 28px;
      border-radius: 16px;
      border: 1px solid var(--border-subtle);
      max-width: 520px;
      width: 92%;
      box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
    }
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: var(--text-secondary);
    }
    .site-footer a { color: var(--brand-primary); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="brand-logo">
        <span class="brand-mark">🎓</span>
        <span>AlumniConnect</span>
      </a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/users">Users</a>
        <a href="/announcements" class="active">Announcements</a>
        <a href="/job-postings">Job Postings</a>
        <a href="/applications">Applications</a>
        <a href="/about">About</a>
        <a href="/api/swagger">Swagger API</a>
      </div>
    </div>
  </nav>

  <main class="container">
    <div class="page-header">
      <div>
        <span class="badge-pill">📢 Institutional Bulletins & Campus News</span>
        <h1>Announcements Management</h1>
        <p class="subtitle">
          Publish and curate university-wide notices, career fairs, mentorship kickoffs, and alumni reunion bulletins.
        </p>
      </div>
      <a href="/api/announcements" target="_blank" class="btn btn-secondary">⚡ View JSON API (/api/announcements)</a>
    </div>

    <!-- CREATE: New Announcement Form -->
    <div class="card">
      <h2>➕ Publish New Bulletin</h2>
      <form action="/announcements" method="POST">
        <div class="form-grid">
          <div>
            <label>Announcement Title *</label>
            <input type="text" name="title" placeholder="e.g. Annual Alumni Gala 2026" required>
          </div>
          <div>
            <label>Category</label>
            <select name="category">
              <option value="General">General</option>
              <option value="Event">Event</option>
              <option value="Career">Career</option>
              <option value="Mentorship">Mentorship</option>
            </select>
          </div>
          <div>
            <label>Publishing Office / Author *</label>
            <input type="text" name="author" placeholder="e.g. Rectorate / Career Center" required>
          </div>
        </div>
        <div style="margin-top: 16px;">
          <label>Bulletin Content *</label>
          <textarea name="content" rows="3" placeholder="Provide full details of the announcement..." required></textarea>
        </div>
        <div style="margin-top: 18px;">
          <button type="submit" class="btn btn-primary">Post Announcement</button>
        </div>
      </form>
    </div>

    <!-- READ: Announcements List -->
    <div class="card">
      <h2>Active Bulletins (<%= announcements.length %>)</h2>
      <% if (announcements.length === 0) { %>
        <p style="color: var(--text-muted);">No announcements posted yet.</p>
      <% } else { %>
        <% announcements.forEach(function(a) { %>
          <div class="announcement-item">
            <div style="flex-grow: 1;">
              <div class="announcement-title">
                <span class="cat-tag"><%= a.category %></span>
                <span><%= a.title %></span>
              </div>
              <div class="announcement-content"><%= a.content %></div>
              <div class="announcement-meta">
                <span>✍️ Author: <strong style="color: var(--text-secondary);"><%= a.author %></strong></span>
                <span>📅 <%= new Date(a.created_at).toLocaleDateString() %></span>
                <span style="font-family: var(--font-mono);">🆔 #<%= a.id %></span>
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-edit" onclick="openEditModal(<%= a.id %>, '<%= a.title.replace(/'/g, "\\'") %>', '<%= a.content.replace(/'/g, "\\'") %>', '<%= a.category %>', '<%= a.author.replace(/'/g, "\\'") %>')">✏️ Edit</button>
              <form action="/announcements/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Delete this announcement?');">
                <button type="submit" class="btn btn-delete">🗑️ Delete</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>

  <!-- UPDATE Modal -->
  <div id="editModal" class="modal">
    <div class="modal-content">
      <h2 style="font-family: var(--font-display); font-size: 20px; margin-bottom: 16px;">Edit Announcement</h2>
      <form id="editForm" method="POST">
        <div style="margin-bottom: 14px;">
          <label>Title</label>
          <input type="text" id="editTitle" name="title" required>
        </div>
        <div style="margin-bottom: 14px;">
          <label>Category</label>
          <select id="editCategory" name="category">
            <option value="General">General</option>
            <option value="Event">Event</option>
            <option value="Career">Career</option>
            <option value="Mentorship">Mentorship</option>
          </select>
        </div>
        <div style="margin-bottom: 14px;">
          <label>Author</label>
          <input type="text" id="editAuthor" name="author" required>
        </div>
        <div style="margin-bottom: 14px;">
          <label>Content</label>
          <textarea id="editContent" name="content" rows="3" required></textarea>
        </div>
        <div style="display: flex; gap: 10px; margin-top: 20px;">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <footer class="site-footer">
    AlumniConnect — University Alumni & Career Network ·
    <a href="/">Home</a> · <a href="/users">Users</a> · <a href="/job-postings">Job Postings</a>
  </footer>

  <script>
    function openEditModal(id, title, content, category, author) {
      document.getElementById('editForm').action = '/announcements/' + id + '/update';
      document.getElementById('editTitle').value = title;
      document.getElementById('editContent').value = content;
      document.getElementById('editCategory').value = category;
      document.getElementById('editAuthor').value = author;
      document.getElementById('editModal').style.display = 'flex';
    }
    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
    }
  </script>
</body>
</html>
