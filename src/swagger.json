{
  "openapi": "3.0.0",
  "info": {
    "title": "Alumni, Users & Announcements MVC API",
    "version": "1.0.0",
    "description": "API documentation with MVC architecture for Users, Alumni, and Announcements (Homework)"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "summary": "Users HTML View (Listings)",
        "tags": ["View Layer (/users)"],
        "description": "Renders EJS view with list of all users and add user form",
        "responses": {
          "200": { "description": "HTML web page" }
        }
      },
      "post": {
        "summary": "Create user from HTML form",
        "tags": ["View Layer (/users)"],
        "description": "Processes form submission and redirects to /users",
        "responses": {
          "302": { "description": "Redirects to /users" }
        }
      }
    },
    "/announcements": {
      "get": {
        "summary": "Announcements HTML View (Homework)",
        "tags": ["View Layer (/announcements)"],
        "description": "Renders EJS view with list of active announcements and post form",
        "responses": {
          "200": { "description": "HTML web page" }
        }
      },
      "post": {
        "summary": "Create announcement from HTML form",
        "tags": ["View Layer (/announcements)"],
        "description": "Processes form submission and redirects to /announcements",
        "responses": {
          "302": { "description": "Redirects to /announcements" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "tags": ["System"],
        "description": "Returns system uptime and database connection status",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "uptime": 12.34,
                  "database": "connected",
                  "timestamp": "2026-10-07T10:00:00.000Z"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "List all users (JSON)",
        "tags": ["API Users (/api/users)"],
        "responses": {
          "200": { "description": "A list of users" }
        }
      },
      "post": {
        "summary": "Create a new user (JSON)",
        "tags": ["API Users (/api/users)"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "summary": "Get user by ID",
        "tags": ["API Users (/api/users)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "User details" },
          "404": { "description": "User not found" }
        }
      },
      "put": {
        "summary": "Full update of user (PUT)",
        "tags": ["API Users (/api/users)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "User updated" },
          "404": { "description": "User not found" }
        }
      },
      "patch": {
        "summary": "Partial update of user (PATCH)",
        "tags": ["API Users (/api/users)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserPatchInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "User partially updated" },
          "404": { "description": "User not found" }
        }
      },
      "delete": {
        "summary": "Delete user by ID",
        "tags": ["API Users (/api/users)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "User deleted" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/announcements": {
      "get": {
        "summary": "List all announcements (JSON)",
        "tags": ["API Announcements (/api/announcements)"],
        "responses": {
          "200": { "description": "List of announcements" }
        }
      },
      "post": {
        "summary": "Create announcement (JSON)",
        "tags": ["API Announcements (/api/announcements)"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnnouncementInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Announcement created" }
        }
      }
    },
    "/api/announcements/{id}": {
      "get": {
        "summary": "Get announcement by ID",
        "tags": ["API Announcements (/api/announcements)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Announcement details" },
          "404": { "description": "Announcement not found" }
        }
      },
      "put": {
        "summary": "Full update announcement (PUT)",
        "tags": ["API Announcements (/api/announcements)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnnouncementInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Announcement updated" },
          "404": { "description": "Announcement not found" }
        }
      },
      "patch": {
        "summary": "Partial update announcement (PATCH)",
        "tags": ["API Announcements (/api/announcements)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnnouncementPatchInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Announcement partially updated" },
          "404": { "description": "Announcement not found" }
        }
      },
      "delete": {
        "summary": "Delete announcement by ID",
        "tags": ["API Announcements (/api/announcements)"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Announcement deleted" },
          "404": { "description": "Announcement not found" }
        }
      }
    },
    "/api/alumni": {
      "get": {
        "summary": "List all alumni",
        "tags": ["Alumni"],
        "responses": {
          "200": { "description": "List of alumni" }
        }
      },
      "post": {
        "summary": "Add new alumni",
        "tags": ["Alumni"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AlumniInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Alumni created" }
        }
      }
    },
    "/api/alumni/{id}": {
      "get": {
        "summary": "Get alumni by ID",
        "tags": ["Alumni"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Alumni details" },
          "404": { "description": "Alumni not found" }
        }
      },
      "put": {
        "summary": "Update alumni",
        "tags": ["Alumni"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AlumniInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Alumni updated" },
          "404": { "description": "Alumni not found" }
        }
      },
      "delete": {
        "summary": "Delete alumni",
        "tags": ["Alumni"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Alumni deleted" },
          "404": { "description": "Alumni not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserInput": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string", "example": "emre" },
          "email": { "type": "string", "example": "emre@alumni.com" },
          "password": { "type": "string", "example": "pass123" },
          "phone": { "type": "string", "example": "555-0001" }
        }
      },
      "UserPatchInput": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "emre" },
          "email": { "type": "string", "example": "emre@alumni.com" },
          "password": { "type": "string", "example": "pass123" },
          "phone": { "type": "string", "example": "555-9999" }
        }
      },
      "AnnouncementInput": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string", "example": "Annual Alumni Gala 2026" },
          "content": { "type": "string", "example": "Join us on campus for networking and dinner." },
          "category": { "type": "string", "example": "Event" },
          "author": { "type": "string", "example": "Rectorate" }
        }
      },
      "AnnouncementPatchInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Updated Gala Title" },
          "content": { "type": "string", "example": "Updated announcement details." },
          "category": { "type": "string", "example": "Event" },
          "author": { "type": "string", "example": "Alumni Office" }
        }
      },
      "AlumniInput": {
        "type": "object",
        "required": ["first_name", "last_name"],
        "properties": {
          "first_name": { "type": "string", "example": "Dilara" },
          "last_name": { "type": "string", "example": "Toraman" },
          "email": { "type": "string", "example": "dilara@example.com" },
          "department": { "type": "string", "example": "Bilgisayar Mühendisliği" },
          "graduation_year": { "type": "integer", "example": 2026 }
        }
      }
    }
  }
}
